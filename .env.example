# ─── STRIPE ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys

# Secret key — NEVER expose this in the frontend or commit to git
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY_HERE

# Publishable key — goes in the frontend HTML files (already in place)
# Replace pk_test_YOUR_PUBLISHABLE_KEY_HERE in each .html file
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY_HERE

# ─── NOTES ────────────────────────────────────────────────────────────────────
# 1. Add STRIPE_SECRET_KEY to Netlify:
#    Site Settings → Environment Variables → Add variable
#
# 2. Never commit your actual .env file — only this .env.example
#
# 3. For local dev, copy this file to .env and fill in your keys:
#    cp .env.example .env
